                  "pm.test(\"El Markdown lleva el título pedido\", () => pm.expect(r.markdown).to.include(\"# Ventas de prueba\"));",
                  "pm.test(\"Sin avisos\", () => pm.expect(r.avisos).to.eql([]));"
                ]
