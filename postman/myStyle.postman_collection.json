    {
      "name": "3. Crear archivos",
      "item": [
        {
          "name": "POST receta → PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/render",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "render"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receta\": \"informe_negocio\",\n  \"valores\": {\n    \"titulo\": \"Informe desde Postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Estado ok o con_avisos\", () => pm.expect(r.estado).to.be.oneOf([\"ok\", \"con_avisos\"]));",
                  "pm.test(\"Trae job de 12 hex\", () => pm.expect(r.job).to.match(/^[0-9a-f]{12}$/));",
                  "pm.test(\"Trae la URL firmada del PDF\", () => pm.expect(r.pdf).to.include(\"/v1/files/\"));",
                  "pm.collectionVariables.set(\"job\", r.job);",
                  "pm.collectionVariables.set(\"pdfUrl\", r.pdf);",
                  "pm.test(\"Responde en menos de 15 s\", () => pm.expect(pm.response.responseTime).to.be.below(15000));"
                ]
              }
            }
          ]
        },
