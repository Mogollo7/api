{
  "info": {
    "name": "myStyle API",
    "description": "Pruebas de la API de myStyle (recetas, render, calidad, estilos). Ejecuta de arriba abajo: la solicitud «receta → PDF» guarda `job` y `pdfUrl` para las siguientes. Guía: POSTMAN_DOCUMENTATION.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Verificar la API",
      "item": [
        {
          "name": "GET herramientas (la API está viva)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tools"
              ]
            },
            "description": "Respuesta esperada: lista de herramientas en function calling estilo OpenAI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
                  "const t = pm.response.json();",
                  "pm.test(\"Hay al menos 20 herramientas\", () => pm.expect(t.length).to.be.at.least(20));",
                  "pm.test(\"Incluye list_recipes y create_from_recipe\", () => { const n = t.map(x => x.function.name); pm.expect(n).to.include.members([\"list_recipes\", \"create_from_recipe\"]); });",
                  "pm.test(\"Responde en menos de 15 s\", () => pm.expect(pm.response.responseTime).to.be.below(15000));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET herramientas (perfil mínimo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tools?perfil=minimo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tools"
              ],
              "query": [
                {
                  "key": "perfil",
                  "value": "minimo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El perfil mínimo es corto (≤ 12)\", () => pm.expect(pm.response.json().length).to.be.at.most(12));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET diseños publicados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/designs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "designs"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Hay diseños con id, nombre y versión\", () => pm.response.json().forEach(d => pm.expect(d).to.include.all.keys(\"id\", \"name\", \"version\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET openapi.json",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es un documento OpenAPI\", () => pm.expect(pm.response.json()).to.have.property(\"paths\"));"
                ]
              }
            }
          ]
        }
      ]
