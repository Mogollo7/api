              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/library?q=cifras clave&tipo=componente",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "library"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "cifras clave"
                },
                {
                  "key": "tipo",
                  "value": "componente"
                }
              ]
